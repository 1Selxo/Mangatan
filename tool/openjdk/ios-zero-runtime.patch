 address os::fetch_frame_from_context(const void* ucVoid,
                                      intptr_t** ret_sp,
                                      intptr_t** ret_fp) {
+#if defined(__APPLE__) && (defined(__aarch64__) || defined(__arm64__))
+  const ucontext_t* uc = (const ucontext_t*) ucVoid;
+  if (uc == nullptr) {
+    if (ret_sp != nullptr) *ret_sp = nullptr;
+    if (ret_fp != nullptr) *ret_fp = nullptr;
+    return nullptr;
+  }
+  if (ret_sp != nullptr) *ret_sp = (intptr_t*) uc->ZERO_CONTEXT_SP;
+  if (ret_fp != nullptr) *ret_fp = (intptr_t*) uc->ZERO_CONTEXT_FP;
+  return os::Posix::ucontext_get_pc(uc);
+#else
   ShouldNotCallThis();
   return nullptr;
+#endif
 }
 
 frame os::fetch_frame_from_context(const void* ucVoid) {
+#if defined(__APPLE__) && (defined(__aarch64__) || defined(__arm64__))
+  intptr_t* sp = nullptr;
+  address pc = fetch_frame_from_context(ucVoid, &sp, nullptr);
+  frame result;
+  result.set_sp(sp);
+  result.set_pc(pc);
+  return result;
+#else
   ShouldNotCallThis();
   return frame();
+#endif
 }
 
 intptr_t* os::fetch_bcp_from_context(const void* ucVoid) {
+#if defined(__APPLE__) && (defined(__aarch64__) || defined(__arm64__))
+  // Zero keeps the bytecode pointer in interpreterState, not a native
+  // register, so there is no BCP to recover from a Darwin ucontext.
+  return nullptr;
+#else
   ShouldNotCallThis();
   return nullptr;
+#endif
 }
 
