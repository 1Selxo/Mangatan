# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  media_kit_libs_target = installer.pods_project.targets.find { |target| target.name == 'media_kit_libs_ios_video' }
  media_kit_video_target = installer.pods_project.targets.find { |target| target.name == 'media_kit_video' }

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    if target == media_kit_video_target
      target.build_configurations.each do |configuration|
        key = 'FRAMEWORK_SEARCH_PATHS[sdk=iphonesimulator*]'
        configuration.build_settings[key] = Array(configuration.build_settings[key]) +
          ['"${PODS_XCFRAMEWORKS_BUILD_DIR}/media_kit_libs_ios_video"']
        configuration.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] =
          '$(inherited) i386 x86_64'
      end
    end

    next unless target.name == 'm_extension_server'

    # OpenJDK Zero has thousands of native initializers. Keep the pod target
    # from linking it into the app launch image; Runner embeds its lazy copy.
    target.frameworks_build_phase.files
      .select { |file| file.display_name.include?('OpenJDKRuntime') }
      .each(&:remove_from_project)
  end

  if media_kit_libs_target && media_kit_video_target
    phase = media_kit_libs_target.new_shell_script_build_phase('[Mangayomi] Prepare media-kit simulator frameworks')
    phase.shell_script = <<~'SH'
      if [ "${PLATFORM_NAME}" != "iphonesimulator" ]; then
        exit 0
      fi

      source_root="${PODS_ROOT}/../.symlinks/plugins/media_kit_libs_ios_video/ios/Frameworks"
      output_root="${PODS_XCFRAMEWORKS_BUILD_DIR}/media_kit_libs_ios_video"
      mkdir -p "${output_root}"

      for xcframework in "${source_root}"/*.xcframework; do
        name="$(basename "${xcframework}" .xcframework)"
        source_framework="${xcframework}/ios-arm64/${name}.framework"
        destination_framework="${output_root}/${name}.framework"
        [ -d "${source_framework}" ] || continue

        rm -rf "${destination_framework}"
        ditto "${source_framework}" "${destination_framework}"
        binary="${destination_framework}/${name}"
        patched="${binary}.iossim"
        /usr/bin/xcrun vtool \
          -set-build-version iossim "${IPHONEOS_DEPLOYMENT_TARGET:-13.0}" "${SDK_VERSION}" \
          -replace -output "${patched}" "${binary}"
        /bin/mv "${patched}" "${binary}"
      done
    SH
    media_kit_video_target.add_dependency(media_kit_libs_target)
  end

end

post_integrate do |installer|
  # The app embeds its own lazily loaded OpenJDK runtime. The current
  # m_extension_server pod also vendors a framework with the same product
  # name, so remove only that framework from CocoaPods' aggregate embed lists
  # to avoid a duplicate output while keeping the plugin itself linked.
  support_dir = File.join(
    installer.sandbox.root.to_s,
    'Target Support Files',
    'Pods-Runner',
  )
  Dir.glob(File.join(support_dir, 'Pods-Runner-frameworks*')).each do |path|
    next unless File.file?(path)

    filtered = File.readlines(path).reject { |line| line.include?('OpenJDKRuntime') }
    File.write(path, filtered.join)
  end
  Dir.glob(File.join(support_dir, 'Pods-Runner*.xcconfig')).each do |path|
    contents = File.read(path)
    contents.gsub!(/\s-framework\s+"OpenJDKRuntime"/, '')
    File.write(path, contents)
  end

  runner_project = installer.aggregate_targets
    .map(&:user_project)
    .compact
    .first
  embed_phase = runner_project&.native_targets
    .find { |target| target.name == 'Runner' }
    &.shell_script_build_phases
    &.find { |phase| phase.name == '[CP] Embed Pods Frameworks' }
  if embed_phase
    embed_phase.shell_script += <<~'SH'

      if [ -d "${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}/OpenJDKRuntime.framework" ]; then
        identity="${EXPANDED_CODE_SIGN_IDENTITY}"
        [ -n "${identity}" ] || identity="-"
        /usr/bin/codesign --force --sign "${identity}" --timestamp=none \
          "${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}/OpenJDKRuntime.framework"
      fi
    SH
    runner_project.save
  end
end
